+func (rw nopConn) Write(b []byte) (int, error) { return 0, io.EOF }
+
+// FEATURE-REJECTBUF: WriteBuffer takes ownership of the buffer. sing's copy
+// loop calls buffer.Leak() on a write error, which panics ("leaking buffer")
+// in debug-tagged builds; releasing here makes that Leak() a no-op
+// (Leak returns early once the buffer is unmanaged), so a REJECTed
+// connection can no longer abort the :background process.
+func (rw nopConn) WriteBuffer(buffer *buf.Buffer) error {
+	buffer.Release()
+	return io.EOF
+}
